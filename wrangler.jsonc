{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "dr-consulta-api",
  "main": "worker/index.mjs",
  "compatibility_date": "2026-09-22",
  "vars": {
    "GEMINI_MODEL": "gemini-3.6-flash",
    "GEMINI_FALLBACK_MODEL": "gemini-3.5-flash-lite",
    "SITE_URL": "https://joaocisneros.github.io/Dr.-Consulta/"
  },
  // Máximo 12 consultas por minuto por IP.
  "ratelimits": [
    { "name": "CHAT_LIMITER", "namespace_id": "1001", "simple": { "limit": 12, "period": 60 } }
  ]
}
